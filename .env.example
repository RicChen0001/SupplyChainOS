# SupplyChainOS — copy to .env and fill in local values. Never commit real secrets.
# Database
POSTGRES_DB=supplychainos
POSTGRES_USER=supplychainos
POSTGRES_PASSWORD=change-me-in-local-env
DATABASE_URL=jdbc:postgresql://localhost:5432/supplychainos
DB_USERNAME=supplychainos
DB_PASSWORD=change-me-in-local-env

# Backend
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Session cookie: dev uses lax + http-only; production must set SECURE=true behind HTTPS.
SESSION_COOKIE_SECURE=false

# Frontend (Vite dev proxy forwards /api -> backend, so no API URL needed in dev)
VITE_API_BASE_URL=
